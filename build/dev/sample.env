COMPOSE_NAME=kp

# === Proxy ===

HOSTNAME=kp.localhost
PORT=80
BACKEND_PREFIX=/api/kp
DJANGO_PORT=8000
VITE_PREFIX=/vite
NEXTCLOUD_PREFIX=$BACKEND_PREFIX/nextcloud

# === DB ===

POSTGRES_PASSWORD=password

DB_HOST_DJANGO=db
DB_PORT_DJANGO=5432
DB_HOST_LIFERAY=$DB_HOST_DJANGO
DB_PORT_LIFERAY=$DB_PORT_DJANGO
DB_HOST_NEXTCLOUD=$DB_HOST_DJANGO
DB_PORT_NEXTCLOUD=$DB_PORT_DJANGO

DB_USER_DJANGO=django
DB_PASSWORD_DJANGO=password
DB_NAME_DJANGO=$DB_USER_DJANGO

DB_USER_LIFERAY=liferay
DB_PASSWORD_LIFERAY=password
DB_NAME_LIFERAY=$DB_USER_LIFERAY

DB_USER_NEXTCLOUD=nextcloud
DB_PASSWORD_NEXTCLOUD=password
DB_NAME_NEXTCLOUD=$DB_USER_NEXTCLOUD

# === Django ===

DJANGO_SECRET_KEY="secret_key"
DJANGO_DEBUG=true
DJANGO_CHALLENGE_URL=http://liferay:8080/api/jsonws/user/get-current-user
DJANGO_ALLOWED_HOSTS=$HOSTNAME

# === Vite ===

VITE_EMAIL=petrov2@voda.gov.ru
VITE_PAUTH=password

# === Nextcloud ===

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin
NEXTCLOUD_CHALLENGE_URL=http://django:${DJANGO_PORT}${BACKEND_PREFIX}/api/nextcloud/validate/
