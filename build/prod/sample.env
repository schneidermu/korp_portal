COMPOSE_NAME=kp

# === Proxy ===

HOSTNAME=sslgis.favr.ru
BACKEND_PREFIX=/api/kp
DJANGO_PORT=8000
NEXTCLOUD_PREFIX=$BACKEND_PREFIX/nextcloud
VITE_PREFIX=/vite

# === DB ===

DB_HOST_DJANGO=
DB_PORT_DJANGO=5432
DB_HOST_NEXTCLOUD=$DB_HOST_DJANGO
DB_PORT_NEXTCLOUD=$DB_PORT_DJANGO
DB_HOST_LIFERAY=$DB_HOST_DJANGO
DB_PORT_LIFERAY=$DB_PORT_DJANGO

DB_NAME_DJANGO=
DB_NAME_NEXTCLOUD=
DB_NAME_LIFERAY=liferay

DB_USER_DJANGO=
DB_PASSWORD_DJANGO=
DB_USER_NEXTCLOUD=$DB_USER_DJANGO
DB_PASSWORD_NEXTCLOUD=$DB_PASSWORD_DJANGO
DB_USER_LIFERAY=$DB_USER_DJANGO
DB_PASSWORD_LIFERAY=$DB_PASSWORD_DJANGO

# === Django ===

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_CHALLENGE_URL=http://liferay:8080/api/jsonws/region/fetch-region/region-id/0
DJANGO_ALLOWED_HOSTS=$HOSTNAME

# === Nextcloud ===

NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_CHALLENGE_URL=http://django:${DJANGO_PORT}${BACKEND_PREFIX}/api/nextcloud/validate/
